---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Página no encontrada | Curso React de midudev" description="La página que buscas no existe. Vuelve al curso de React gratis de midudev." noindex>
  <div class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center gap-6 px-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-sky-800">Error 404</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Esta página no existe</h1>
    <p class="text-lg text-slate-600">Puede que la dirección esté mal escrita o que el contenido se haya movido.</p>
    <a class="rounded-lg bg-sky-800 px-5 py-3 font-semibold text-white hover:bg-sky-900" href="/">Volver al curso de React</a>
  </div>
</Layout>
