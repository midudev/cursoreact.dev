---
import { CLASES } from "../consts"
import Layout from "../layouts/Layout.astro"
import Footer from "../components/Footer.astro"
export function getStaticPaths() { return CLASES.map((info, index) => ({ params: { clase: info.slug }, props: { info, index } })) }
interface Props { info: (typeof CLASES)[number]; index: number }
const { info, index } = Astro.props
const modules = import.meta.glob('../clases/*.mdx')
const module = modules[`../clases/${info.slug}.mdx`]
const Content = module ? (await module() as { default: any }).default : null
---
<Layout title={`${info.title} | Curso React gratis de midudev`} description={info.description} jsonLd={{
  "@context": "https://schema.org", "@graph": [
    { "@type": "LearningResource", name: info.title, description: info.description, inLanguage: "es", isAccessibleForFree: true, learningResourceType: "Clase", url: `https://cursoreact.dev/${info.slug}`, isPartOf: { "@type": "Course", name: "Curso de React de midudev", url: "https://cursoreact.dev/" } },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Curso React", item: "https://cursoreact.dev/" }, { "@type": "ListItem", position: 2, name: info.title, item: `https://cursoreact.dev/${info.slug}` }] }
  ]
}}>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <nav aria-label="Ruta de navegación" class="mb-8 text-sm text-sky-800"><a href="/">← Todas las clases de React</a></nav>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <article class="min-w-0">
        <button type="button" data-video={info.id} class="video group relative block w-full overflow-hidden rounded-2xl bg-slate-900 text-white" aria-label={`Reproducir clase: ${info.title}`}>
          <img src={`/${index + 1}.webp`} alt="" width="1280" height="720" fetchpriority="high" class="aspect-video w-full object-cover" />
          <span class="absolute inset-0 flex items-center justify-center bg-black/20"><span class="rounded-xl bg-sky-800 px-6 py-3 font-semibold group-hover:bg-sky-900">▶ Ver clase</span></span>
        </button>
        <p class="mt-7 text-sm font-semibold text-sky-800">Clase {String(index + 1).padStart(2, '0')}</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{info.title}</h1>
        <ul class="my-5 flex flex-wrap gap-2">{info.learnings.map((l: string) => <li class="rounded-md bg-sky-50 px-2 py-1 text-sm text-sky-900">{l}</li>)}</ul>
        <div class="mb-8 flex flex-wrap gap-3 font-semibold text-sky-800">
          {info.code && <a href={info.code} target="_blank" rel="noopener noreferrer">Código fuente</a>}
          {info.web && <a href={info.web} target="_blank" rel="noopener noreferrer">Ver demo</a>}
          <a href={`https://www.youtube.com/watch?v=${info.id}`} target="_blank" rel="noopener noreferrer">Ver en YouTube</a>
        </div>
        <div class="prose prose-slate max-w-none prose-a:text-sky-800">{Content ? <Content components={{ h1: "h2" }} /> : <p>{info.description}</p>}</div>
        <nav aria-label="Siguiente y anterior clase" class="my-10 flex justify-between gap-5 text-sm font-semibold text-sky-800">
          {index > 0 && <a href={`/${CLASES[index - 1].slug}`}>← Clase anterior</a>}
          {index < CLASES.length - 1 && <a href={`/${CLASES[index + 1].slug}`}>Siguiente clase →</a>}
        </nav>
      </article>
      <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-5 lg:sticky lg:top-6">
        <h2 class="mb-4 text-xl font-bold">Curso de React</h2>
        <nav aria-label="Temario"><ol class="space-y-1">{CLASES.map((c, i) => <li><a href={`/${c.slug}`} aria-current={c.slug === info.slug ? 'page' : undefined} class:list={["block rounded-lg px-3 py-2 text-sm hover:bg-sky-100", c.slug === info.slug ? 'bg-sky-100 font-semibold text-sky-900' : 'text-slate-700']}>{String(i + 1).padStart(2, '0')}. {c.title}</a></li>)}</ol></nav>
      </aside>
    </div>
    <Footer />
  </div>
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach(button => {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe')
      frame.src = `https://www.youtube-nocookie.com/embed/${button.dataset.video}?autoplay=1`
      frame.title = button.getAttribute('aria-label') || 'Clase de React'
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
      frame.allowFullscreen = true
      frame.className = 'aspect-video w-full rounded-2xl border-0'
      button.replaceWith(frame)
    }, { once: true })
  })
</script>
